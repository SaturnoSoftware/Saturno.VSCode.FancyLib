{
  "name": "saturno-fancylib",
  "displayName": "Saturno.VSCode.FancyLib",
  "description": "Shared kit for the Saturno Fancy VS Code extensions",
  "version": "2.0.0",
  "build": 6,
  "license": "GPL-3.0-only",
  "private": true,
  "author": {
    "name": "Saturno Software",
    "url": "https://saturno.software"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SaturnoSoftware/Saturno.VSCode.FancyLib.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "compile": "tsc -p Tests/tsconfig.json",
    "test": "npm run compile && node --test out/Tests/*.test.js",
    "lint": "eslint Source Tests --ext ts"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  },
  "saturno": {
    "cicd": {
      "artifactPrefix": "Saturno.VSCode.FancyLib",
      "build": {
        "stagingRoot": "__BUILD/_staging",
        "expectedFiles": [
          "package.json",
          "README.md",
          "LICENSE.txt",
          "Source/index.ts"
        ]
      }
    }
  }
}
