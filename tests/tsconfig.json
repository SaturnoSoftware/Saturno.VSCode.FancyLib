    "../Source/About/HeaderCard.ts",
    "../Source/About/Page.ts",
    "../Source/About/index.ts",
    "../Source/DevBugReport/Types.ts",
    "../Source/DevBugReport/Report.ts",
    "../Source/DevBugReport/Renderer.ts",
    "../Source/DevBugReport/Redaction.ts",
